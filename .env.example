PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=
DEPLOYER_PRIVATE_KEY=
# Wallet operator (Sepolia): membayar gas faucet dan penetasan otomatis. Isi dengan Sepolia ETH.
OPERATOR_PRIVATE_KEY=
ETHERSCAN_API_KEY=
# 1 = jawaban tiruan tanpa model (hanya untuk uji). Produksi: 0
MOCK_LLM=0
# 1 = akun Anvil & LLM tiruan untuk `bun run e2e` (hanya CHAIN=anvil; `bun run start --test` mengisinya)
TEST_ACCOUNTS=0
CHAIN=anvil
MAX_RPM=20
MAX_TPM=8000

# server publik (CHAIN=sepolia otomatis dianggap publik; PUBLIC=1 untuk menguji di Anvil)
UI_PORT=5173
PUBLIC=0
# harga sekali run per agent, dibayar lewat LineageRoyalty. 0 = gratis tapi dijatah per IP
RUN_PRICE_ETH=0
RUN_LIMIT_PER_HOUR=6
# 1 bila server di belakang Caddy/nginx, agar batas per IP memakai X-Forwarded-For
TRUST_PROXY=0

# Privy (login email/Google/wallet). Kosong = mode demo lokal saja.
PRIVY_APP_ID=
# Faucet untuk pengguna baru, dibayar wallet operator (OPERATOR_PRIVATE_KEY)
FAUCET_AMOUNT_ETH=0.003
FAUCET_PER_IP_DAY=3
FAUCET_DAILY_CAP_ETH=0.05
# Opsional saat deploy: jeda kawin dasar dalam blok (bawaan kontrak 10)
BASE_COOLDOWN_BLOCKS=
# Marketplace (dipakai saat deploy)
STUDIO_FEE_ETH=0
MARKET_FEE_BPS=1000
CREDITS_DEFAULT_PRICE_ETH=0
# Alamat publik server, dipakai di perintah pemasangan MCP
PUBLIC_URL=

# Beta: jatah gratis & batas biaya model (lihat docs/superpowers/plans/2026-10-01-real-mode-studio-ux.md)
FREE_TASKS_PER_DAY=5
STUDIO_PER_DAY=3
DAILY_TOKEN_BUDGET=300000
QUOTA_RESET_HOUR_WIB=7
# kelas model paling tinggi untuk publik (fast | balanced | strong) dan batas panjang jawaban
MAX_TIER=balanced
MAX_OUTPUT_TOKENS=3000
MAX_AGENT_STEPS=10
FULL_MODE_PUBLIC=0
# alamat admin dipisah koma (panel /admin)
ADMIN_ADDRESSES=
# garam acak untuk hash akun di metrik
METRICS_SALT=
