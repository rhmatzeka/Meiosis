PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=
DEPLOYER_PRIVATE_KEY=
# alamat pemilik founder setelah deploy, dipisah koma (kosong = tetap milik deployer)
FOUNDER_OWNERS=
# stud fee awal tiap founder
STUD_FEE_ETH=0
OPERATOR_PRIVATE_KEY=
ETHERSCAN_API_KEY=
MOCK_LLM=1
CHAIN=anvil
MAX_RPM=20
MAX_TPM=8000

# server publik (CHAIN=sepolia otomatis dianggap publik; PUBLIC=1 untuk menguji di Anvil)
UI_PORT=5173
PUBLIC=0
# harga sekali run per agent, dibayar lewat LineageRoyalty. 0 = gratis tapi dijatah per IP
RUN_PRICE_ETH=0
RUN_LIMIT_PER_HOUR=6
# 1 bila server di belakang Caddy/nginx, agar batas per IP memakai X-Forwarded-For
TRUST_PROXY=0
