{
  "name": "meiosis",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyze:litter": "bun run scripts/analyze-litter.ts",
    "anvil": "anvil --block-time 2",
    "arena": "bun run scripts/discrimination-test.ts",
    "build:web": "rm -rf dist/web && bun build web/index.html --outdir dist/web --splitting --production --sourcemap=linked",
    "demo:local": "bun run scripts/demo-local.ts",
    "demo:runtime": "bun run scripts/demo-runtime.ts",
    "deploy:sepolia": "CHAIN=sepolia bun run scripts/deploy.ts",
    "e2e": "bun run scripts/e2e.ts",
    "gen-golden": "bun run scripts/gen-golden.ts",
    "gene-sim": "bun run scripts/gene-sim.ts",
    "litter": "bun run scripts/litter.ts",
    "setup": "bun run scripts/setup.ts",
    "skills:hash": "bun run scripts/skills-hash.ts",
    "start": "bun run scripts/start.ts",
    "stop": "bun run scripts/stop.ts",
    "test": "bun test runtime/ web/ server/ packages/",
    "test:contracts": "forge test --root contracts",
    "test:sandbox": "bun run scripts/test-sandbox.ts",
    "trace-leak": "bun run scripts/trace-leak.ts",
    "ui": "bun run server/api.ts",
    "ui:sepolia": "CHAIN=sepolia bun run server/api.ts",
    "verify": "bun run scripts/verify.ts",
    "verify-agent": "bun run scripts/verify-agent.ts",
    "verify:sepolia": "bun run scripts/verify-etherscan.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@privy-io/react-auth": "3.46.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "react": "19",
    "react-dom": "19",
    "viem": "^2.21.0"
  }
}
