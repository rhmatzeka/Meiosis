{
  "name": "meiosis",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyze:litter": "bun run scripts/analyze-litter.ts",
    "anvil": "anvil --block-time 2",
    "arena": "bun run scripts/discrimination-test.ts",
    "demo:local": "bun run scripts/demo-local.ts",
    "demo:runtime": "bun run scripts/demo-runtime.ts",
    "e2e": "bun run scripts/e2e.ts",
    "e2e:full": "bun run scripts/e2e.ts --full",
    "gen-golden": "bun run scripts/gen-golden.ts",
    "gene-sim": "bun run scripts/gene-sim.ts",
    "litter": "bun run scripts/litter.ts",
    "setup": "bun install && forge install foundry-rs/forge-std --no-git --root contracts",
    "start": "bun run scripts/start.ts",
    "stop": "bun run scripts/stop.ts",
    "test": "bun test runtime/",
    "test:contracts": "forge test --root contracts",
    "test:sandbox": "bun run scripts/test-sandbox.ts",
    "ui": "bun run server/api.ts",
    "verify": "bun run scripts/verify.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "viem": "^2.21.0"
  }
}
